{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "NEXT_PUBLIC_API_URL",
    "PORT",
    "NODE_ENV",
    "ALGORITHM",
    "ACCESS_TOKEN_EXPIRES_IN",
    "CORS_ORIGIN",
    "USER_SECRET",
    "SESSION_SECRET",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "RESEND_API_KEY",
    "EMAIL_ADDRESS",
    "EMAIL_PASSWORD",
    "UPLOADTHING_SECRET",
    "UPLOADTHING_APP_ID",
    "CLOUDINARY_API_KEY",
    "CLOUDINARY_NAME",
    "CLOUDINARY_SECRET",
    "CLOUDINARY_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "DATABASE_URL",
        "NEXT_PUBLIC_API_URL",
        "PORT",
        "NODE_ENV",
        "ALGORITHM",
        "ACCESS_TOKEN_EXPIRES_IN",
        "CORS_ORIGIN",
        "USER_SECRET",
        "SESSION_SECRET",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "RESEND_API_KEY",
        "EMAIL_ADDRESS",
        "EMAIL_PASSWORD",
        "UPLOADTHING_SECRET",
        "UPLOADTHING_APP_ID",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_NAME",
        "CLOUDINARY_SECRET",
        "CLOUDINARY_URL"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}